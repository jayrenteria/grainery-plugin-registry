---
import Layout from '../../layouts/Layout.astro';
import { formatDate, getPlugins, installUrl, packageUrl, permissionDetail, type Plugin } from '../../lib/catalog';

export async function getStaticPaths() {
	return (await getPlugins()).map((plugin) => ({ params: { id: plugin.id }, props: { plugin } }));
}

const { plugin } = Astro.props as { plugin: Plugin };
const corePermissions = plugin.manifest?.permissions ?? [];
const optionalPermissions = plugin.manifest?.optionalPermissions ?? [];
const permissionRationales = plugin.manifest?.permissionRationales ?? {};
const engine = plugin.manifest?.engine;
const versions = plugin.versions ?? [{ version: plugin.version, releaseNotes: plugin.releaseNotes, publishedAt: plugin.publishedAt, yanked: false, downloadUrl: plugin.downloadUrl }];
---

<Layout title={`${plugin.name} - Grainery Plugins`} description={plugin.description}>
	<section class="plugin-head">
		<div class="container">
			<a class="back" href="/">All plugins</a>
			<div class="heading">
				<div class="plugin-mark" aria-hidden="true">{plugin.icon ? <img src={plugin.icon} alt="" /> : plugin.name.slice(0, 1)}</div>
				<div>
					<p class="eyebrow">Verified registry plugin</p>
					<h1>{plugin.name}</h1>
					<p class="byline">{plugin.publisher?.name ? `By ${plugin.publisher.name}` : plugin.id} <span>v{plugin.version}</span></p>
				</div>
			</div>
			<p class="description">{plugin.description}</p>
			<div class="actions" aria-describedby="install-status">
				<a class="install" href={installUrl(plugin)}>Install in Grainery</a>
				<a class="download" href={packageUrl(plugin)}>Download unverified package</a>
			</div>
			<p id="install-status" class="install-status">Grainery will show the plugin and its permissions for confirmation, then verify the signed package before installing it. Manual downloads are installed as unverified sideloads.</p>
		</div>
	</section>

	<section class="details">
		<div class="container detail-grid">
			<article>
				<h2>About</h2>
				<p>{plugin.description}</p>
				{plugin.screenshots?.length ? <section class="screenshots" aria-labelledby="screenshots-title"><h2 id="screenshots-title">Screenshots</h2>{plugin.screenshots.map((screenshot) => <figure><img src={screenshot.url} alt={screenshot.alt} loading="lazy" /><figcaption>{screenshot.alt}</figcaption></figure>)}</section> : null}
				<section class="release-notes" aria-labelledby="release-notes-title">
					<h2 id="release-notes-title">Release notes</h2>
					<p>{plugin.releaseNotes ?? 'No release notes were supplied for this version.'}</p>
				</section>
				<section class="version-history" aria-labelledby="versions-title">
					<h2 id="versions-title">Version history</h2>
					<ol>
						{versions.map((version) => <li><div class="version-line"><strong>v{version.version}</strong>{version.yanked ? <span class="yanked">Yanked</span> : version.version === plugin.version ? <span class="current">Current</span> : null}{formatDate(version.publishedAt) && <time datetime={version.publishedAt}>{formatDate(version.publishedAt)}</time>}</div>{version.releaseNotes && <p>{version.releaseNotes}</p>}{!version.yanked && version.downloadUrl && version.version !== plugin.version && <a href={version.downloadUrl}>Download v{version.version}</a>}</li>)}
					</ol>
				</section>
			</article>
			<aside aria-label="Plugin details">
				<h2>Registry status</h2>
				<p class="verified"><strong>Verified registry</strong><br />The published package is signed by the Grainery registry.</p>
				<h2>Compatibility</h2>
				<dl>
					{engine?.grainery && <><dt>Grainery</dt><dd>{engine.grainery}</dd></>}
					{engine?.pluginApi && <><dt>Plugin API</dt><dd>{engine.pluginApi}</dd></>}
				</dl>
				<h2>Details</h2>
				<dl>
					<dt>Plugin ID</dt><dd><code>{plugin.id}</code></dd>
					{plugin.publisher?.name && <><dt>Publisher</dt><dd>{plugin.publisher.url ? <a href={plugin.publisher.url}>{plugin.publisher.name}</a> : plugin.publisher.name}</dd></>}
					{plugin.license && <><dt>License</dt><dd>{plugin.license}</dd></>}
					{formatDate(plugin.publishedAt) && <><dt>Published</dt><dd><time datetime={plugin.publishedAt}>{formatDate(plugin.publishedAt)}</time></dd></>}
					{plugin.repositoryUrl && <><dt>Repository</dt><dd><a href={plugin.repositoryUrl}>View source</a></dd></>}
					{plugin.homepageUrl && <><dt>Website</dt><dd><a href={plugin.homepageUrl}>Visit site</a></dd></>}
				</dl>
				<section class="permission-section" aria-labelledby="core-permissions-title">
					<h2 id="core-permissions-title">Core permissions</h2>
					{corePermissions.length ? <ul class="permissions">{corePermissions.map((permission) => { const detail = permissionDetail(permission); return <li><strong>{detail.label}</strong><span>{detail.description}</span></li>; })}</ul> : <p class="quiet">No core permissions declared.</p>}
				</section>
				<section class="permission-section" aria-labelledby="optional-permissions-title">
					<h2 id="optional-permissions-title">Optional permissions</h2>
					{optionalPermissions.length ? <ul class="permissions">{optionalPermissions.map((permission) => { const detail = permissionDetail(permission); return <li><strong>{detail.label}</strong><span>{permissionRationales[permission] ?? detail.description}</span></li>; })}</ul> : <p class="quiet">No optional permissions declared.</p>}
				</section>
			</aside>
		</div>
	</section>
</Layout>

<style>
	.plugin-head { padding: 2.5rem 0 3.5rem; background: var(--wine); color: var(--paper); }
	.back { color: #f4cb75; font-weight: 700; }
	.heading { display: flex; gap: 1rem; align-items: center; margin-top: 2rem; }
	.plugin-mark { display: grid; width: 68px; height: 68px; place-items: center; overflow: hidden; border-radius: 4px; background: var(--paper); color: var(--wine); font-family: 'Courier Prime', monospace; font-size: 2rem; font-weight: 700; }
	.plugin-mark img { width: 100%; height: 100%; object-fit: cover; }
	.eyebrow { margin: 0 0 0.3rem; color: #f4cb75; font-family: 'Courier Prime', monospace; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; }
	h1 { margin: 0; font-size: 3.6rem; line-height: 1; }
	.byline { margin: 0.5rem 0 0; color: #f2ded9; }
	.byline span { margin-left: 0.5rem; font-family: 'Courier Prime', monospace; font-size: 0.85rem; }
	.description { max-width: 680px; margin: 2rem 0; color: #f2ded9; font-size: 1.15rem; line-height: 1.65; }
	.actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }
	.actions a { border: 2px solid var(--paper); border-radius: 4px; padding: 0.7rem 0.9rem; font-weight: 800; text-decoration: none; }
	.install { background: var(--paper); color: var(--wine); }
	.download { color: var(--paper); }
	.install-status { max-width: 620px; margin: 1rem 0 0; color: #f2ded9; font-size: 0.9rem; line-height: 1.5; }
	.details { padding: 4rem 0 5rem; }
	.detail-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 340px); gap: 5rem; }
	h2 { margin: 0 0 1rem; color: var(--wine); font-size: 1.25rem; }
	article > p, .release-notes > p { max-width: 680px; color: var(--muted); font-size: 1.05rem; line-height: 1.7; white-space: pre-line; }
	aside { border-top: 3px solid var(--wine); padding-top: 1.1rem; }
	dl { margin: 0 0 2.5rem; }
	dt { margin-top: 1rem; color: var(--muted); font-size: 0.83rem; font-weight: 700; }
	dd { margin: 0.2rem 0 0; overflow-wrap: anywhere; }
	code { font-family: 'Courier Prime', monospace; font-size: 0.85rem; }
	.verified { margin: 0 0 2.5rem; color: var(--muted); line-height: 1.55; }
	.verified strong { color: var(--wine); }
	.permission-section { margin-top: 2.5rem; }
	.permissions { margin: 0; padding: 0; list-style: none; }
	.permissions li { display: grid; gap: 0.25rem; margin: 0; padding: 0.8rem 0; border-top: 1px solid var(--line); }
	.permissions strong { color: var(--wine); font-size: 0.94rem; }
	.permissions span { color: var(--muted); font-size: 0.9rem; line-height: 1.45; }
	.quiet { color: var(--muted); line-height: 1.5; }
	.screenshots, .release-notes, .version-history { margin-top: 3rem; }
	.screenshots { display: grid; gap: 1rem; }
	.screenshots h2 { grid-column: 1 / -1; }
	.screenshots figure { margin: 0; }
	.screenshots img { max-width: 100%; border: 1px solid var(--line); border-radius: 4px; }
	figcaption { margin-top: 0.5rem; color: var(--muted); font-size: 0.88rem; }
	.version-history ol { margin: 0; padding: 0; list-style: none; }
	.version-history li { padding: 1rem 0; border-top: 1px solid var(--line); }
	.version-line { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
	.version-line time { color: var(--muted); font-size: 0.9rem; }
	.version-history p { margin: 0.45rem 0; color: var(--muted); line-height: 1.55; white-space: pre-line; }
	.version-history a { font-size: 0.9rem; font-weight: 700; }
	.current, .yanked { border: 1px solid var(--line); padding: 0.12rem 0.35rem; font-family: 'Courier Prime', monospace; font-size: 0.75rem; }
	.yanked { color: var(--wine); }
	@media (max-width: 760px) {
		h1 { font-size: 2.2rem; }
		.detail-grid { grid-template-columns: 1fr; gap: 3rem; }
	}
</style>
