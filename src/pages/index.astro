---
import Layout from '../layouts/Layout.astro';
import { getPlugins, pluginUrl } from '../lib/catalog';

const plugins = await getPlugins();
const categories = [...new Set(plugins.flatMap((plugin) => plugin.categories ?? []))].sort();
---

<Layout title="Grainery Plugins" description="Browse approved plugins for Grainery.">
	<section class="catalog-head">
		<div class="container">
			<p class="eyebrow">Official marketplace</p>
			<h1>Grainery Plugins</h1>
			<p class="intro">Extend your writing room with approved plugins. Packages are signed before publication.</p>
			<div class="catalog-controls">
				<label class="search" for="plugin-search">
					<span class="sr-only">Search plugins</span>
					<input id="plugin-search" type="search" placeholder="Search name, publisher, category, or tag" autocomplete="off" />
				</label>
				{categories.length ? (
					<label class="category-filter" for="category-filter">
						<span class="sr-only">Filter by category</span>
						<select id="category-filter"><option value="">All categories</option>{categories.map((category) => <option value={category}>{category}</option>)}</select>
					</label>
				) : null}
			</div>
		</div>
	</section>

	<section class="catalog" aria-labelledby="catalog-title">
		<div class="container">
			<div class="catalog-bar">
				<h2 id="catalog-title">Available plugins</h2>
				<p id="catalog-count" aria-live="polite">{plugins.length} {plugins.length === 1 ? 'plugin' : 'plugins'}</p>
			</div>
			{plugins.length ? (
				<>
					<ul class="plugin-list" id="plugin-list">
						{plugins.map((plugin) => (
							<li class="plugin-card" data-search={`${plugin.name} ${plugin.description} ${plugin.publisher?.name ?? ''} ${(plugin.categories ?? []).join(' ')} ${(plugin.tags ?? []).join(' ')}`.toLowerCase()} data-categories={(plugin.categories ?? []).join('|')}>
								<a href={pluginUrl(plugin.id)} class="plugin-link">
									<div class="plugin-mark" aria-hidden="true">{plugin.icon ? <img src={plugin.icon} alt="" /> : plugin.name.slice(0, 1)}</div>
									<div>
										<h3>{plugin.name}</h3>
										<p>{plugin.description}</p>
										<div class="meta"><span>Verified registry</span><span>v{plugin.version}</span>{plugin.publisher?.name && <span>{plugin.publisher.name}</span>}{plugin.categories?.slice(0, 2).map((category) => <span>{category}</span>)}</div>
									</div>
									<span class="view">View plugin</span>
								</a>
							</li>
						))}
					</ul>
					<p id="no-results" class="empty hidden" role="status">No plugins match those filters.</p>
				</>
			) : (
				<div class="empty"><h3>The catalog is warming up.</h3><p>Approved plugins will appear here as they are published.</p><a href="https://docs.grainery.xyz/plugins/authoring-quickstart/">Build a plugin</a></div>
			)}
		</div>
	</section>
</Layout>

<script>
	const input = document.querySelector<HTMLInputElement>('#plugin-search');
	const category = document.querySelector<HTMLSelectElement>('#category-filter');
	const cards = [...document.querySelectorAll<HTMLElement>('[data-search]')];
	const noResults = document.querySelector('#no-results');
	const count = document.querySelector('#catalog-count');

	function filterPlugins() {
		const query = input?.value.trim().toLowerCase() ?? '';
		const selectedCategory = category?.value ?? '';
		let visible = 0;
		cards.forEach((card) => {
			const matches = (card.dataset.search?.includes(query) ?? false)
				&& (!selectedCategory || card.dataset.categories?.split('|').includes(selectedCategory));
			card.hidden = !matches;
			if (matches) visible += 1;
		});
		noResults?.classList.toggle('hidden', visible > 0);
		if (count) count.textContent = `${visible} ${visible === 1 ? 'plugin' : 'plugins'}`;
	}

	input?.addEventListener('input', filterPlugins);
	category?.addEventListener('change', filterPlugins);
</script>

<style>
	.catalog-head { padding: 5.5rem 0 4rem; background: var(--wine); color: var(--paper); }
	.eyebrow { margin: 0 0 0.7rem; color: #f4cb75; font-family: 'Courier Prime', monospace; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; }
	h1 { max-width: 780px; margin: 0; font-size: 3.5rem; line-height: 1.05; }
	.intro { max-width: 650px; margin: 1.15rem 0 2rem; color: #f2ded9; font-size: 1.15rem; line-height: 1.6; }
	.catalog-controls { display: flex; flex-wrap: wrap; gap: 0.65rem; }
	.search { flex: 1 1 360px; }
	.search input, .category-filter select { width: 100%; border: 2px solid transparent; border-radius: 4px; padding: 0.9rem 1rem; font: inherit; font-size: 1rem; }
	.category-filter { flex: 0 1 190px; }
	.search input:focus, .category-filter select:focus { border-color: var(--gold); outline: none; }
	.catalog { padding: 3rem 0 5rem; }
	.catalog-bar { display: flex; align-items: baseline; justify-content: space-between; border-bottom: 1px solid var(--line); }
	.catalog-bar h2 { margin: 0 0 1rem; font-size: 1.4rem; }
	.catalog-bar p { color: var(--muted); font-family: 'Courier Prime', monospace; font-size: 0.85rem; }
	.plugin-list { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; border-bottom: 1px solid var(--line); }
	.plugin-card { border-top: 1px solid var(--line); }
	.plugin-link { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; gap: 1rem; align-items: start; padding: 1.4rem 0; color: inherit; text-decoration: none; }
	.plugin-link:hover h3 { color: var(--gold-deep); text-decoration: underline; text-underline-offset: 0.16em; }
	.plugin-mark { display: grid; width: 48px; height: 48px; place-items: center; border-radius: 4px; background: var(--wine); color: var(--paper); font-family: 'Courier Prime', monospace; font-size: 1.3rem; font-weight: 700; }
	.plugin-mark img { width: 100%; height: 100%; border-radius: inherit; object-fit: cover; }
	h3 { margin: 0; color: var(--wine); font-size: 1.1rem; }
	.plugin-link p { margin: 0.3rem 0 0.8rem; color: var(--muted); line-height: 1.45; }
	.meta { display: flex; flex-wrap: wrap; gap: 0.5rem; color: var(--muted); font-family: 'Courier Prime', monospace; font-size: 0.78rem; }
	.meta span { padding: 0.2rem 0.35rem; border: 1px solid var(--line); }
	.view { padding-top: 0.2rem; color: var(--wine); font-weight: 700; white-space: nowrap; }
	.empty { max-width: 520px; padding: 3rem 0; color: var(--muted); line-height: 1.6; }
	.empty h3 { font-size: 1.3rem; }
	.hidden { display: none; }
	.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
	@media (max-width: 620px) {
		.catalog-head { padding: 3.5rem 0 3rem; }
		h1 { font-size: 2.5rem; }
		.search, .category-filter { flex-basis: 100%; }
		.plugin-link { grid-template-columns: 42px minmax(0, 1fr); }
		.plugin-mark { width: 42px; height: 42px; }
		.view { grid-column: 2; padding-top: 0; }
	}
</style>
